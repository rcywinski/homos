{
  "name": "homos",
  "version": "2.0.0",
  "description": "Uniswap v3 concentrated-liquidity research stack: exact bigint math, walk-forward backtesting, propose-only bot and cockpit UI (case study, project closed 2026-09)",
  "scripts": {
    "start": "webpack-dev-server --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run typecheck && npm run test:math && npm run test:ai && npm run backtest:validate",
    "test:math": "tsx test/v3math.test.ts",
    "test:ai": "tsx ai/corpus/split.test.ts",
    "backtest:validate": "tsx backtest/validate.ts",
    "backtest": "tsx backtest/run.ts",
    "backtest:selection": "tsx backtest/selection.ts",
    "scan": "tsx backtest/scan-universe.ts",
    "bot": "tsx bot/observer.ts",
    "bot:server": "tsx bot/server.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "report:morning": "tsx scripts/morning-report.ts",
    "fetch:swaps": "tsx scripts/fetch-swaps.ts",
    "fetch:llama": "tsx scripts/fetch-llama-history.ts",
    "wide:score": "tsx scripts/wide-score.ts",
    "wide:collect": "tsx scripts/wide-collect.ts",
    "wide:daily": "tsx scripts/wide-daily.ts",
    "bench:yield": "tsx scripts/yield-benchmark.ts",
    "fetch:funding:hl": "tsx scripts/fetch-funding-hl.ts",
    "fetch:dvol": "tsx scripts/fetch-dvol.ts",
    "fetch:vault": "tsx scripts/fetch-vault-perf.ts",
    "backtest:carry": "tsx backtest/funding-carry.ts",
    "backtest:house-edge": "tsx backtest/vault-house-edge.ts",
    "backtest:lp-timing": "tsx backtest/lp-vol-timing.ts",
    "agent": "tsx scripts/agent-runner.ts",
    "wallet": "tsx scripts/wallet.ts",
    "ai:chunks": "tsx ai/corpus/chunks-cli.ts",
    "ai:find": "tsx ai/eval/find-cli.ts",
    "ai:golden:check": "tsx ai/eval/golden-check-cli.ts"
  },
  "author": "Rafał Cywiński",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@envio-dev/hypersync-client": "1.0.0",
    "@tanstack/react-query": "^5.69.0",
    "@uniswap/sdk-core": "^7.7.2",
    "@uniswap/v3-sdk": "^3.25.2",
    "connectkit": "1.8.2",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "jsbi": "^4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "technicalindicators": "^3.1.0",
    "viem": "^2.7.15",
    "wagmi": "^2.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.24.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^6.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.9",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^3.3.4",
    "tsx": "^4.23.12",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.71.0",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rcywinski/homos.git"
  },
  "engines": {
    "node": ">=20"
  }
}
