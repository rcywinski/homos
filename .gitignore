# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables — secrets never go into the repo; .env.example (a template
# without values) MUST stay in the repo, so it is not excluded here.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist
.cache/
public/bundle.js*

# Working data, caches and bot state — all regenerable.
data/
.agent/
.bot/
backtest/results/

# IDE and Editor files
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tool caches
.eslintcache

# Coverage directory used by tools like istanbul
/coverage

# Misc
*.log
*.pid
*.seed
*.pid.lock
.agent-queue/
public/*.bundle.js
public/*.bundle.js.LICENSE.txt

# Private working journal and generated morning reports
private-journal/
reports/
