# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables — secrets never go into the repo; .env.example (a template
# without values) MUST stay in the repo, so it is not excluded here.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist
.cache/
public/bundle.js*

# Working data, caches and bot state — all regenerable.
data/
.agent/
.bot/
# Snapshot of the live bot state from the decommissioned server (Aug-Sep 2026). Kept locally,
# not committed: it may feed the agent tools in phase 2.
.bot-live-backup/
backtest/results/
# AI layer: generated embeddings and search indexes (rebuild with npm run ai:index).
# Evaluation results in ai/eval/results/ are committed on purpose.
ai/index/
# Agent run logs (step 2.2): one JSONL per question, full tool results; selected transcripts are copied to
# ai/eval/results/ on purpose.
ai/agent/logs/
# Agent job outputs (step 2.3): one directory per job id with the plan, the log and the result.
ai/agent/runs/
# Python (inference/ services): bytecode cache and virtual environments.
__pycache__/
.venv/

# IDE and Editor files
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tool caches
.eslintcache

# Coverage directory used by tools like istanbul
/coverage

# Misc
*.log
*.pid
*.seed
*.pid.lock
.agent-queue/
public/*.bundle.js
public/*.bundle.js.LICENSE.txt

