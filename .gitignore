# bez wartości) MUSI zostać w repo, więc nie jest tu wykluczony.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist
.cache/
public/bundle.js*

# HOMOS: dane robocze / cache / stan bota — regenerowalne, nie do repo.
# Cały katalog data/ (cache, historie llama, bundle transferowe) trzymamy poza repo.
data/
.agent/
.bot/
backtest/results/

# Legacy backupy tworzone w trakcie sesji AI (np. legacy-AddLiquidity.tsx.bak)
legacy-*.bak

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
