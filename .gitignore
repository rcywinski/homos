# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables — secrets never go into the repo; .env.example (a template
# without values) MUST stay in the repo, so it is not excluded here.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist
.cache/
public/bundle.js*

# HOMOS: working data / caches / bot state — regenerable, not for the repo.
# The whole data/ directory (caches, DefiLlama histories, transfer bundles) stays out of the repo.
data/
.agent/
.bot/
backtest/results/

# Legacy backups created during AI sessions (e.g. legacy-AddLiquidity.tsx.bak)
legacy-*.bak

# IDE and Editor files
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuration files
.babelrc
.babel.config.js
.prettierrc
.eslintrc
.eslintcache

# Coverage directory used by tools like istanbul
/coverage

# Misc
*.log
*.pid
*.seed
*.pid.lock
.agent-queue/
public/*.bundle.js
public/*.bundle.js.LICENSE.txt

# private working journal (kept locally / in HOMOS-private, not in the public HEAD)
private-journal/
