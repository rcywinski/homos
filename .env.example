# .env.example — szablon zmiennych środowiskowych HOMOS.
# Skopiuj do .env i uzupełnij wartości: `cp .env.example .env` (Mac) albo
# `Copy-Item .env.example .env` (Windows). .env NIE jest commitowany (patrz .gitignore).

# --- UI (wagmi/ConnectKit) ---
# ID projektu WalletConnect (https://cloud.walletconnect.com) — do łączenia
# portfeli (Rabby, MetaMask itd.) z interfejsem webowym.
WALLET_CONNECT_PROJECT_ID=

# --- Skrypty pomocnicze (scripts/wallet.ts) — programowy dostęp do portfela ---
# Klucz prywatny do lokalnych skryptów diagnostycznych (scripts/wallet.ts).
# NIE jest to klucz operacyjny bota — tryb PROPONUJ/AUTO ma docelowo osobny
# klucz operacyjny trzymany WYŁĄCZNIE na serwerze Windows, zaszyfrowany DPAPI
# (patrz INFRA.md §3), nigdy w tym pliku i nigdy w repo.
PRIVATE_KEY=
# RPC używane przez scripts/wallet.ts (osobne od RPC_MAINNET/RPC_BASE poniżej).
RPC_URL=

# --- Bot-obserwator (bot/config.ts, bot/observer.ts) ---
# Adres portfela, którego pozycje Uniswap V3 ma obserwować bot (fallback w
# kodzie to adres testowy — w produkcji USTAW na swój adres).
BOT_WATCH_ADDRESS=

# Własne RPC dla bota (opcjonalne — bez nich używane są publiczne fallbacki
# drpc/publicnode/llamarpc, które bywają ograniczane pod obciążeniem).
RPC_MAINNET=
RPC_BASE=

# Alerty Telegram z propozycjami bota (opcjonalne). Token bota: @BotFather,
# TG_CHAT: ID czatu/kanału, na który bot ma wysyłać wiadomości.
TG_TOKEN=
TG_CHAT=

# --- Bot API (bot/server.ts) ---
# Port, na którym nasłuchuje API+statyczne UI (domyślnie 8787, jeśli puste).
BOT_API_PORT=8787
# Token dostępu do /api/* — WYMAGANY na serwerze produkcyjnym (Windows,
# dostępny w sieci LAN/VPN — patrz INFRA.md §3). Bez niego /api/* jest otwarte
# dla każdego w tej samej sieci. Puste = brak autoryzacji (tylko dev na Macu).
# UI trzyma ten sam token w localStorage pod kluczem `homos_api_token`.
BOT_API_TOKEN=
