# .env.example — HOMOS environment variable template.
# Copy to .env and fill in the values: `cp .env.example .env` (Mac) or
# `Copy-Item .env.example .env` (Windows). .env is not committed (see .gitignore).

# --- UI (wagmi/ConnectKit) ---
# WalletConnect project ID (https://cloud.walletconnect.com) — for connecting
# wallets (Rabby, MetaMask, etc.) to the web interface.
WALLET_CONNECT_PROJECT_ID=

# --- Observer bot (bot/config.ts, bot/observer.ts) ---
# Address of the wallet whose Uniswap V3 positions the bot should watch
# (required — there is no default in the code). Also used by `npm run wallet`.
BOT_WATCH_ADDRESS=

# Own RPCs for the bot (optional — without them the public fallbacks
# drpc/publicnode/llamarpc are used, which tend to be rate-limited under load).
RPC_MAINNET=
RPC_BASE=

# Telegram alerts with the bot's proposals (optional). Bot token: @BotFather,
# TG_CHAT: ID of the chat/channel the bot should send messages to.
TG_TOKEN=
TG_CHAT=

# --- Bot API (bot/server.ts) ---
# Port the API+static UI listens on (defaults to 8787 if empty).
BOT_API_PORT=8787
# Access token for /api/* — required on the production server (Windows,
# reachable on the LAN/VPN — see docs/INFRA.md §2). Without it /api/* is open
# to anyone on the same network. Empty = no authorization (dev on the Mac only).
# The UI keeps the same token in localStorage under the key `homos_api_token`.
BOT_API_TOKEN=

# --- AI layer (ai/, see docs/AI-PLAN.md) ---
# Anthropic API key (https://console.anthropic.com, Settings > API keys).
# Used to answer questions over the journal and, in phase 2, by the agent.
ANTHROPIC_API_KEY=
# Base URL of the local inference box (Ollama on the Windows GPU box, see
# inference/README.md). Used for embeddings now and the reranker later.
# Example: http://192.168.1.8:11434 (LAN) or the VPN address of the same box.
INFERENCE_URL=
# Base URL of the reranker service on the same box (inference/reranker, port 11435).
# Example: http://192.168.1.8:11435
RERANK_URL=

# --- Showcase front end (showcase/, phase 4, see ai/APP-PLAN.md) ---
# Public wallet address shown read-only in the wallet panel, inlined at build time. Empty = the panel says no address
# is configured. Must be a 0x address; the showcase cannot connect a wallet or sign anything.
SHOWCASE_WALLET_ADDRESS=

# --- Public chat backend (ai/serve/, phase 4) ---
# The chat process must run WITHOUT ANTHROPIC_API_KEY in its environment (it refuses to start otherwise) and does not
# read this file: the service that starts it passes INFERENCE_URL, RERANK_URL and the values below explicitly.
# local (default) or fake: the dry run of step 4.4b, fake models over the real corpus, no GPU and no box URLs.
SERVE_ENGINE=
# Served engine preset (ai/serve/config.ts); empty = qwen-p-local, the configuration measured in step 3.2.
SERVE_PRESET=
# Loopback only (127.0.0.1, localhost or ::1); the chat is reached through the tunnel. Empty = 127.0.0.1.
SERVE_HOST=
# Port of the chat backend (0 = any free port, for tests). Empty = 8790.
SERVE_PORT=
# Longest accepted question in characters. Empty = 500.
SERVE_MAX_QUESTION_CHARS=
# Generator timeout per question in milliseconds. Empty = 180000.
SERVE_GENERATE_TIMEOUT_MS=
# Deadline of one queued job from its start, in milliseconds. Empty = 240000.
SERVE_JOB_DEADLINE_MS=
# Questions allowed to wait behind the running one. Empty = 5.
SERVE_QUEUE_MAX=
# Per visitor per rolling hour, per visitor per UTC day, and for the whole site per UTC day. Empty = 5, 20, 200.
SERVE_LIMIT_HOUR=
SERVE_LIMIT_DAY=
SERVE_LIMIT_GLOBAL_DAY=
# local (default): the visitor is the socket address. tunnel: behind Cloudflare Tunnel (step 4.9), the visitor is
# CF-Connecting-IP, and the server refuses to start unless it listens on 127.0.0.1 only.
SERVE_MODE=
# Request log directory (daily visitor hashes, never IP addresses). Empty = ai/serve/logs (gitignored).
SERVE_LOG_DIR=
# While this file exists the chat answers "paused". Empty = ai/serve/PAUSED (gitignored).
SERVE_PAUSE_FILE=
# Dry run only (SERVE_ENGINE=fake): delay of each fake answer in milliseconds, used by the browser suite. Empty = 0.
SERVE_FAKE_DELAY_MS=
# Owner switch of the models (step 4.10): a file containing "on" lets visitors load the models; missing or anything
# else = off, so a restart never loads by itself. The pause file wins. Empty = ai/serve/SWITCH (gitignored); on the
# box, a path outside the repo. Read by the dry run from step 4.10a, by the real engine from 4.10b.
SERVE_SWITCH_FILE=
# Model loads (step 4.10), counted apart from questions: per visitor per hour, per visitor per UTC day, for the site
# per UTC day. Empty = 2, 6, 30.
SERVE_LOAD_LIMIT_HOUR=
SERVE_LOAD_LIMIT_DAY=
SERVE_LOAD_LIMIT_GLOBAL_DAY=
# After a failed model load, no new load for this many milliseconds. A failed load counts against the visitor's load
# limit but not against the site's daily total. Empty = 120000 (2 minutes).
SERVE_LOAD_COOLDOWN_MS=
# Typical load stage times in milliseconds, shown to visitors while loading (measured on the box, step 4.10d).
# Empty = 1000, 21000, 3000, 1000.
SERVE_TYPICAL_RELEASE_MS=
SERVE_TYPICAL_GENERATOR_MS=
SERVE_TYPICAL_EMBEDDER_MS=
SERVE_TYPICAL_CHECK_MS=
# Dry run only: duration of each fake load stage in milliseconds (empty = 300), and a stage that fails on purpose
# (empty, generator, embedder or check), for the browser suite.
SERVE_FAKE_LOAD_MS=
SERVE_FAKE_LOAD_FAIL=
# keep_alive of the generator and bge-m3 on the box. Since step 4.10b the server releases them itself (after 15
# minutes without questions, or when the owner switch goes off); keep_alive is only the ceiling if the server dies.
# Empty = 60m. Examples: 60m, 90m.
SERVE_KEEP_ALIVE=
