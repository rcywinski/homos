# .env.example — HOMOS environment variable template.
# Copy to .env and fill in the values: `cp .env.example .env` (Mac) or
# `Copy-Item .env.example .env` (Windows). .env is NOT committed (see .gitignore).

# --- UI (wagmi/ConnectKit) ---
# WalletConnect project ID (https://cloud.walletconnect.com) — for connecting
# wallets (Rabby, MetaMask, etc.) to the web interface.
WALLET_CONNECT_PROJECT_ID=

# --- Helper scripts (scripts/wallet.ts) — programmatic wallet access ---
# Private key for local diagnostic scripts (scripts/wallet.ts).
# This is NOT the bot's operational key — the PROPOSE/AUTO mode is meant to have a separate
# operational key kept EXCLUSIVELY on the Windows server, encrypted with DPAPI
# (see INFRA.md §3), never in this file and never in the repo.
PRIVATE_KEY=
# RPC used by scripts/wallet.ts (separate from RPC_MAINNET/RPC_BASE below).
RPC_URL=

# --- Observer bot (bot/config.ts, bot/observer.ts) ---
# Address of the wallet whose Uniswap V3 positions the bot should watch
# (REQUIRED — there is no default in the code; set it to your own address).
BOT_WATCH_ADDRESS=

# Own RPCs for the bot (optional — without them the public fallbacks
# drpc/publicnode/llamarpc are used, which tend to be rate-limited under load).
RPC_MAINNET=
RPC_BASE=

# Telegram alerts with the bot's proposals (optional). Bot token: @BotFather,
# TG_CHAT: ID of the chat/channel the bot should send messages to.
TG_TOKEN=
TG_CHAT=

# --- Bot API (bot/server.ts) ---
# Port the API+static UI listens on (defaults to 8787 if empty).
BOT_API_PORT=8787
# Access token for /api/* — REQUIRED on the production server (Windows,
# reachable on the LAN/VPN — see INFRA.md §3). Without it /api/* is open
# to anyone on the same network. Empty = no authorization (dev on the Mac only).
# The UI keeps the same token in localStorage under the key `homos_api_token`.
BOT_API_TOKEN=
